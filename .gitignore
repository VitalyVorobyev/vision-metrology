# Rust
target/

# Python
**/.venv/
**/__pycache__/
**/*.pyc
dist/
*.egg-info/
.pytest_cache/
.ruff_cache/

# Local datasets and generated outputs (not distributed)
data/

# lab/ (visual metrology lab: FastAPI backend + React frontend, not part of the Cargo
# workspace). `data/`, `.venv/` and `dist/` above already cover lab/backend/data,
# lab/backend/.venv and lab/frontend/dist; node_modules is the one new pattern needed.
node_modules/

# `maturin develop`/`build` places the compiled extension directly in the
# mixed-layout source tree (python-source = "python" in vm-python's
# pyproject.toml); only the hand-written __init__.py/.pyi/py.typed are checked in.
crates/vm-python/python/vision_metrology/*.so
crates/vm-python/python/vision_metrology/*.pyd
crates/vm-python/python/vision_metrology/*.dylib

# Tauri writes its own generated ACL/capability schemas here on every build
# (`cargo tauri build`/`dev`) — same convention as visual-anomaly-lab's src-tauri.
lab/frontend/src-tauri/gen/schemas/
